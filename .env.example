# Groq API Key (for Layer 3 LLM wrapper)
GROQ_API_KEY=your_groq_api_key_here

# Model paths
CLASSIFIER_MODEL_PATH=models/classifier

# Classifier threshold (confidence above which to block)
CLASSIFIER_CONFIDENCE_THRESHOLD=70.0

# Canary token settings
CANARY_TOKEN_LENGTH=32
NUM_CANARY_TOKENS=5

# Groq model for Layer 3 auditor
GROQ_MODEL=llama-3.1-8b-instant

# Tool call history length for Layer 3
TOOL_CALL_HISTORY_LENGTH=3

# Supabase (for logging decisions - optional)
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_key

# API settings
API_HOST=0.0.0.0
API_PORT=8000
